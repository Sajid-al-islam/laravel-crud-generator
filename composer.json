{
    "name": "sajidul-islam/laravel-crud-generator",
    "description": "Generate complete CRUD for any Laravel stack — Blade, API, React, Vue, Svelte, Livewire, Nova, Filament.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Muhammad Sajidul Islam",
            "email": "sajid285.me@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "doctrine/dbal": "^3.0|^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "laravel/prompts": "^0.1|^0.2|^0.3"
    },
    "autoload": {
        "psr-4": {
            "SajidUlIslam\\CrudGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SajidUlIslam\\CrudGenerator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SajidUlIslam\\CrudGenerator\\CrudGeneratorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
